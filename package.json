{
  "name": "pdfmango",
  "version": "0.2.0",
  "description": "Free, open-source PDF tool that runs entirely in the browser: merge, reorder, rotate, delete, images to PDF, compress. Files never leave your device.",
  "license": "AGPL-3.0-or-later",
  "author": "Venkatarangan Thirumalai",
  "homepage": "https://pdf.mangoidiots.com",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/make-fixtures.mjs tests/fixtures",
    "fixtures:large": "node scripts/make-fixtures.mjs tests/fixtures/large --large",
    "brand": "node scripts/make-brand-assets.mjs",
    "icons": "node scripts/make-icons.mjs",
    "screenshots": "node scripts/make-screenshots.mjs"
  },
  "dependencies": {
    "comlink": "4.4.2",
    "mupdf": "1.28.1",
    "sortablejs": "1.15.7"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "0.47.5",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "22.20.4",
    "@types/sortablejs": "1.15.9",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3",
    "workbox-window": "7.4.1"
  }
}
